{
  "manifest_version": 3,
  "name": "ECOMPRO",
  "version": "1.8.0",
  "description": "ECOMPRO: lee los pedidos y la huella digital que Dropi muestra en tu pantalla y los manda a tu tablero, con tu propia sesión.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.dropi.gt/*",
    "https://*.dropi.co/*",
    "https://*.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ECOMPRO · Dropi en vivo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dropi.gt/*",
        "https://*.dropi.co/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.dropi.gt/*",
        "https://*.dropi.co/*"
      ],
      "js": [
        "normalize.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.vercel.app/*"
      ],
      "js": [
        "content-ecompro.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}