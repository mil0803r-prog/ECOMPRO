{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/app"
    },
    {
      "source": "/pedidos-dropi",
      "destination": "/api/app?v=dropi"
    },
    {
      "source": "/login",
      "destination": "/api/login"
    },
    {
      "source": "/auth/callback",
      "destination": "/api/callback"
    },
    {
      "source": "/logout",
      "destination": "/api/logout"
    }
  ],
  "functions": {
    "api/app.js": {
      "includeFiles": "private/*.html"
    },
    "api/db.js": {
      "includeFiles": "private/seed.json"
    },
    "api/descargar.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@ffmpeg-installer/**"
    },
    "api/meta-sync.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/meta-sync",
      "schedule": "17 11 * * *"
    }
  ]
}
